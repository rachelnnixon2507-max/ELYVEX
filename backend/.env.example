# ==============================================================================
# ELYVEX ECHO HUB — BACKEND CONFIGURATION
# ==============================================================================

PORT=5001

# Recipient email where distress notifications and help requests are sent (Admin / Evaluator)
CANDIDATE_EMAIL=your-email@example.com

# ==============================================================================
# SMTP CONFIGURATION (Nodemailer)
# ==============================================================================
# For Gmail:
# 1. Enable 2-Step Verification in your Google Account
# 2. Generate an "App Password" at https://myaccount.google.com/apppasswords
# 3. Put your Gmail address in SMTP_USER and the 16-character App Password in SMTP_PASS

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Frontend Origin for CORS
FRONTEND_ORIGIN=http://localhost:5174

# ==============================================================================
# AI CHATBOT CONFIGURATION (Google Gemini)
# ==============================================================================
# Get your free Gemini API Key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
